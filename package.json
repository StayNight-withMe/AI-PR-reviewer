{
  "name": "pr-review-mcp",
  "version": "1.3.4",
  "description": "GitHub-style pull request review UI as an MCP server: builds a local review page for uncommitted changes, branch commits or explicit commits, collects inline comments and exports the review as Markdown/JSON for an AI.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "pr-review-mcp": "src/index.js",
    "pr-review": "src/cli.js",
    "pr": "src/pr.js",
    "review": "src/pr.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "review": "node src/cli.js",
    "pr": "node src/pr.js",
    "review:serve": "node scripts/serve-5454.js",
    "test": "node --test tests/unit.mjs tests/github-unit.mjs tests/settings-unit.mjs tests/config.test.mjs",
    "test:ui": "node tests/e2e.mjs",
    "test:ui:extra": "node tests/e2e-extra.mjs",
    "test:ui:regressions": "node tests/regressions.mjs",
    "test:synthetic": "node tests/synthetic.mjs",
    "test:page": "node tests/page-process.mjs",
    "test:mcp": "node tests/mcp.mjs",
    "test:cli": "node tests/cli.mjs",
    "test:session": "node tests/session.mjs",
    "test:session:isolation": "node tests/session-isolation.mjs",
    "test:editors": "node tests/editors.mjs",
    "test:editors:configs": "python tests/editors_configs.py",
    "test:github": "node tests/github.mjs",
    "test:pr": "node tests/pr-mode.mjs",
    "test:pr:command": "node tests/pr-command.mjs",
    "test:open-browser": "node tests/open-browser.mjs",
    "test:package-bins": "node tests/package-bins.mjs",
    "test:update": "node tests/self-update.mjs",
    "update": "node scripts/self-update.mjs",
    "test:publish": "node tests/publish.mjs",
    "test:pr:flow": "node tests/pr-publish-flow.mjs",
    "test:committed": "node tests/committed-content.mjs",
    "test:threads": "node tests/threads.mjs",
    "test:ui:suite": "node tests/ui-suite.mjs",
    "test:layout": "node tests/layout-regression.mjs",
    "test:pr:ui": "node tests/pr-page.mjs",
    "test:artifacts": "node tests/artifacts.mjs",
    "test:header:ui": "node tests/file-header-ui.mjs",
    "test:resolve": "node tests/resolve.mjs",
    "test:defects": "node tests/review-defects.mjs",
    "test:concurrent": "node tests/concurrent-pages.mjs",
    "test:symbols:prose": "node tests/symbols-prose.mjs",
    "test:note-images": "node tests/note-images.mjs",
    "test:settings": "node tests/settings-persistence.mjs",
    "bundle:server": "node scripts/bundle-server.mjs",
    "bundle:hljs": "node scripts/build-hljs-bundle.mjs",
    "gh:check": "node scripts/ensure-gh.mjs --check",
    "gh:install": "node scripts/ensure-gh.mjs --install",
    "postinstall": "node scripts/ensure-gh.mjs --check --never-fail",
    "test:all": "npm run test && npm run test:session && npm run test:session:isolation && npm run test:cli && npm run test:synthetic && npm run test:page && npm run test:mcp && npm run test:github && npm run test:pr && npm run test:publish && npm run test:committed && npm run test:logic && npm run test:threads && npm run test:viewed && npm run test:pr:ui && npm run test:pr:flow && npm run test:artifacts && npm run test:header:ui && npm run test:resolve && npm run test:defects && npm run test:symbols:prose && npm run test:concurrent && npm run test:foreign && npm run test:bad-input && npm run test:rename && npm run test:path-guard && npm run test:arg-guard && npm run test:note-images && npm run test:settings && npm run test:pr:command && npm run test:package-bins && npm run test:open-browser && npm run test:update && npm run test:editors && npm run test:editors:vscode && npm run test:editors:vscode:package && npm run test:ui:regressions && npm run test:layout && npm run test:ui:suite && npm run test:ui && npm run test:ui:extra",
    "test:arg-guard": "node tests/arg-guard.mjs",
    "test:path-guard": "node tests/path-guard.mjs",
    "test:rename": "node tests/commit-rename.mjs",
    "test:bad-input": "node tests/bad-input.mjs",
    "test:foreign": "node tests/foreign-request.mjs",
    "test:logic:resolve": "node tests/logic-resolve.mjs",
    "test:logic:outdated": "node tests/logic-outdated.mjs",
    "test:logic:grouping": "node tests/logic-grouping.mjs",
    "test:logic": "npm run test:logic:resolve && npm run test:logic:outdated && npm run test:logic:grouping && npm run test:logic:cycle",
    "test:logic:cycle": "node tests/logic-cycle.mjs",
    "test:editors:vscode": "npm --prefix editors/vscode run test",
    "test:editors:vscode:package": "node editors/vscode/test-in-editor.mjs",
    "build:vsix:vs": "node editors/visualstudio/build-vsix.mjs",
    "test:viewed": "node tests/viewed-sync.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "highlight.js": "^11.12.0",
    "zod": "^4.6.7"
  },
  "license": "MIT",
  "devDependencies": {
    "geckodriver": "^8.0.0",
    "playwright-core": "^1.65.0",
    "selenium-webdriver": "^4.51.0"
  }
}
